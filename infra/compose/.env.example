# FoxSay local 开发环境
# 用法：cp .env.example .env 后按需修改。compose 自动读取同目录 .env。

# ---- PostgreSQL ----
POSTGRES_USER=foxsay
POSTGRES_PASSWORD=foxsay_dev
POSTGRES_DB=foxsay

# ---- MinIO (S3 兼容对象存储) ----
MINIO_ACCESS_KEY=foxsay
MINIO_SECRET_KEY=foxsay_dev_password
MINIO_BUCKET=foxsay-content

# ---- Backend (uv 跑时使用) ----
DATABASE_URL=postgresql+asyncpg://foxsay:foxsay_dev@localhost:5432/foxsay
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=foxsay
S3_SECRET_KEY=foxsay_dev_password
S3_BUCKET=foxsay-content
ENVIRONMENT=local
LOG_LEVEL=INFO
